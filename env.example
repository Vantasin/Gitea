# UID/GID for the Gitea container user
USER_UID=1000
USER_GID=1000

# Database credentials
GITEA_DB_HOST=db:5432
GITEA_DB_NAME=gitea
GITEA_DB_USER=gitea
GITEA_DB_PASSWORD=changeme

# Gitea configuration
GITEA_ROOT_URL=https://gitea.example.com/
GITEA_SSH_DOMAIN=gitea.example.com
GITEA_SSH_PORT=2222
GITEA_SSH_IP=0.0.0.0
GITEA_DATA_VOLUME=/tank/docker/data/gitea

# Comma-separated webhook targets Gitea is allowed to call.
# Add your CI container hostname, for example: external,woodpecker-server
GITEA_WEBHOOK_ALLOWED_HOST_LIST=external
